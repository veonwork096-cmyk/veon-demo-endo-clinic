---
// Endo Clinic homepage (design/concept.md «Ендокринна вісь», ux/demo-home.md). Only this page in the demo.
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FutureLink from "../components/FutureLink.astro";
import CallButton from "../components/CallButton.astro";
import CallRow from "../components/CallRow.astro";
import PhoneIcon from "../components/PhoneIcon.astro";
import teamCutout from "../assets/img/team-cutout.webp";
import oleksyk from "../assets/img/oleksyk-red.png";
import teamGroup from "../assets/img/team-group.png";
import "../styles/home.css";
import {
  PHONE_MAIN, PHONE_SECOND, HOURS_LINE, ADDRESS, MAP_URL, EMAIL, INSTAGRAM, FACEBOOK, WEEK,
} from "../data/clinic";

const title = "Ендокринологічна клініка в Ужгороді — Endo Clinic";
const description = "Закарпатська Ендоклініка: 8 ендокринологів і ендокринний хірург, чек-апи, УЗД і аналізи, онлайн-консультації. Запис: +38 (099) 268 70 28.";

// Anatomical order, top to bottom (concept §5 «directions»; client.json business_lines[0], W-F005, W-F009, W-F010).
const directions = [
  { name: "Гіпоталамо-гіпофізарна система", text: "Порушення гіпофіза й гіпоталамуса, які керують роботою інших залоз." },
  { name: "Щитоподібна залоза", text: "Консультація ендокринолога, УЗД щитоподібної залози, за потреби пункційна біопсія під контролем УЗД." },
  { name: "Надниркові залози", text: "Діагностика й лікування захворювань надниркових залоз." },
  { name: "Цукровий діабет", text: "Лікування і супровід: очні прийоми, онлайн-супровід і Школа діабету." },
  { name: "Ожиріння та обмін речовин", text: "Обстеження й медичний супровід зниження ваги." },
  { name: "Дитяча ендокринологія", text: "Окремий прийом дитячого ендокринолога; поруч дитячий гастроентеролог." },
];

// Check-ups and programmes by the client's own names (W-F008, W-F009). No prices (W-F010 not carried over).
const checkupGroups = [
  { title: "Щитоподібна залоза", items: [
    { name: "THYROID CHECK", latin: true, who: "Перевірка щитоподібної залози" },
  ] },
  { title: "Вага і діабет", items: [
    { name: "OBESITY CONTROL", latin: true, who: "При надмірній вазі" },
    { name: "DIABETES CONTROL", latin: true, who: "Контроль при цукровому діабеті" },
    { name: "DIABETES CONTROL PREMIUM", latin: true, who: "Розширений контроль діабету" },
    { name: "Контроль ваги: 12 тижнів", latin: false, who: "Програма супроводу на 12 тижнів" },
  ] },
  { title: "Жінкам і чоловікам", items: [
    { name: "ENDO WOMAN", latin: true, who: "Ендокринне обстеження для жінок" },
    { name: "ENDO MEN", latin: true, who: "Ендокринне обстеження для чоловіків" },
    { name: "Check-up здоров’я жінки 40+", latin: false, who: "Для жінок після сорока" },
  ] },
  { title: "Після сорока", items: [
    { name: "ENDO LONGEVITY 40+", latin: true, who: "Профілактика для тих, кому за 40" },
    { name: "Скринінг здоров’я 40+", latin: false, who: "За програмою НСЗУ" },
  ] },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  name: "Endo Clinic",
  alternateName: "Закарпатська Ендоклініка",
  description,
  medicalSpecialty: "Endocrine",
  telephone: ["+380992687028", "+380673756050"],
  email: EMAIL,
  address: {
    "@type": "PostalAddress",
    streetAddress: "вул. Івана Чендея 29 Б",
    addressLocality: "Ужгород",
    addressRegion: "Закарпатська область",
    addressCountry: "UA",
  },
  openingHoursSpecification: [
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: "08:00", closes: "19:00" },
    { "@type": "OpeningHoursSpecification", dayOfWeek: "Saturday", opens: "09:00", closes: "17:00" },
  ],
  sameAs: [INSTAGRAM, FACEBOOK],
};
---
<Base lang="uk" title={title} description={description}>
  <script slot="head" type="application/ld+json" data-rec="W-SEO-R003" set:html={JSON.stringify(jsonLd)} />
  <Header slot="header" />

  <!-- 1. hero: poster. H1 on top, the call desk bottom-left on the axis, the team on the horizon before the red circle. -->
  <Section id="hero" rec="W-UX-R001,W-UX-R003,S-G-R003,S-M-R004,W-A-R006,W-A-R003" class="hero">
    <div class="shell shell--axis hero__shell">
      <h1 class="hero__title" data-rec="W-SEO-R001">
        <span class="hero__line">Ендокринологічна</span>
        <span class="hero__line">клініка в Ужгороді</span>
      </h1>
      <p class="hero__lead">Вісім ендокринологів, ендокринний хірург і суміжні фахівці. Приймаємо дорослих і дітей.</p>
      <div class="hero__desk">
        <span class="axis-node axis-node--desk is-current" data-axis-node="hero"></span>
        <CallButton label="Зателефонувати" showNumber class="hero__call" />
        <p class="hero__second">або <a class="tnum" href={PHONE_SECOND.href}>{PHONE_SECOND.display}</a></p>
        <p class="hero__hours"><span class="hours-status" data-hours-status hidden></span><span class="hours-line">{HOURS_LINE}</span></p>
      </div>
      <div class="hero__visual">
        <span class="hero__sun" aria-hidden="true"></span>
        <Picture
          src={teamCutout}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[420, 640, 860, 1024]}
          sizes="(min-width: 960px) 50vw, 100vw"
          alt="Лікарки Endo Clinic у білих халатах клініки"
          loading="eager"
          fetchpriority="high"
          class="hero__team"
        />
      </div>
    </div>
  </Section>

  <!-- 2. directions: anatomical index, top to bottom of the body. -->
  <Section id="directions" rec="W-UX-R004" class="directions">
    <div class="shell shell--axis">
      <header class="sec-head">
        <span class="axis-node" data-axis-node="directions"></span>
        <h2>Від гіпофіза до обміну речовин</h2>
        <p>Ендокринологія для дорослих і дітей у тому порядку, в якому залози розташовані в тілі.</p>
      </header>
      <ol class="index">
        {directions.map((d) => (
          <li class="index__row">
            <span class="index__node" aria-hidden="true"></span>
            <h3 class="index__name">{d.name}</h3>
            <p class="index__text">{d.text}</p>
            <FutureLink class="index__more">Детальніше</FutureLink>
          </li>
        ))}
      </ol>
      <p class="also">
        <span class="also__title">Також у клініці:</span> дерматологія, гастроентерологія та дієтологія, гінекологія й ендокринна гінекологія, кардіологія, неврологія, офтальмологія, урологія та андрологія, УЗД, генетика, сімейна медицина, психологія.
      </p>
      <CallRow text="Не знаєте, до якого лікаря? Адміністратор підкаже й запише." />
    </div>
  </Section>

  <!-- 3. checkups: asymmetric 4/8, sticky side with the call. -->
  <Section id="checkups" rec="W-UX-R004" class="checkups">
    <div class="shell shell--axis checkups__grid">
      <div class="checkups__side">
        <header class="sec-head">
          <span class="axis-node" data-axis-node="checkups"></span>
          <h2>Сім чек-апів і програми</h2>
          <p>Комплексні обстеження за один візит. Склад і вартість уточнить адміністратор.</p>
        </header>
        <CallButton label="Записатися на чек-ап" class="checkups__call" />
        <FutureLink class="checkups__prices">Ціни</FutureLink>
      </div>
      <div class="checkups__list">
        {checkupGroups.map((g, gi) => (
          <section class="pkg-group" aria-labelledby={`grp-${gi}`}>
            <h3 class="pkg-group__title" id={`grp-${gi}`}>{g.title}</h3>
            <ul class="pkg-group__items">
              {g.items.map((p) => (
                <li class="pkg">
                  <h4 class:list={["pkg__name", { "pkg__name--latin": p.latin }]} lang={p.latin ? "en" : undefined}>{p.name}</h4>
                  <p class="pkg__who">{p.who}</p>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </Section>

  <!-- 4. team: change of density, big photography. -->
  <Section id="team" class="team">
    <div class="shell shell--axis team__grid">
      <figure class="team__lead">
        <Picture
          src={oleksyk}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[360, 560, 783]}
          sizes="(min-width: 960px) 45vw, 100vw"
          alt="Ольга Олексик у червоному жакеті"
          loading="lazy"
          class="team__portrait"
        />
        <figcaption class="team__caption">
          <span class="team__name">Ольга Олексик</span>
          <span>Лікар-ендокринолог вищої категорії, заслужений лікар України, кандидат медичних наук</span>
        </figcaption>
        <FutureLink class="team__all">Вся команда</FutureLink>
      </figure>
      <div class="team__body">
        <header class="sec-head">
          <span class="axis-node" data-axis-node="team"></span>
          <h2>33 фахівці, з них 8 ендокринологів</h2>
        </header>
        <p class="team__statement">Ендокринний хірург, кардіологи, гастроентерологи, гінекологи, неврологи й мамологи: 17 спеціальностей навколо однієї системи організму.</p>
        <figure class="team__group">
          <Picture
            src={teamGroup}
            formats={["avif", "webp"]}
          fallbackFormat="webp"
            widths={[480, 780]}
            sizes="(min-width: 960px) 45vw, 100vw"
            alt="Лікарки Endo Clinic"
            loading="lazy"
          />
        </figure>
      </div>
      <div class="team__call">
        <CallRow text="Запишемо до потрібного лікаря на зручний час." />
      </div>
    </div>
  </Section>

  <!-- 5. diagnostics: paper changes to the well. -->
  <Section id="diagnostics" class="diagnostics">
    <div class="shell shell--axis diagnostics__grid">
      <header class="sec-head">
        <span class="axis-node" data-axis-node="diagnostics"></span>
        <h2>Аналізи, УЗД і генетика — без переїздів</h2>
        <p>Повний комплекс лабораторних досліджень одразу в клініці.</p>
      </header>
      <ul class="diag">
        <li class="diag__item">
          <h3>Лабораторія Astra Dia</h3>
          <p>Клініка — офіційний партнер лабораторії: аналізи здаєте там само, де приймає лікар.</p>
        </li>
        <li class="diag__item">
          <h3>УЗД для всієї родини</h3>
          <p>Ультразвукові дослідження різної складності для дорослих і дітей.</p>
        </li>
        <li class="diag__item">
          <h3>Генетичні дослідження</h3>
          <p>Секвенування екзому й геному в лабораторіях Німеччини та США.</p>
        </li>
      </ul>
      <div class="diagnostics__call">
        <CallRow text="Направили на аналізи чи УЗД? Запишемо на зручний час." />
      </div>
    </div>
  </Section>

  <!-- 6. remote: three rings around the clinic. -->
  <Section id="remote" class="remote">
    <div class="shell shell--axis remote__grid">
      <header class="sec-head remote__head">
        <span class="axis-node" data-axis-node="remote"></span>
        <h2>Ужгород, область, онлайн</h2>
        <p>Лікарі клініки приймають не лише в Ужгороді.</p>
      </header>
      <div class="rings diagram" data-reveal role="img" aria-label="Схема охоплення: клініка в Ужгороді, виїзні прийоми в області, онлайн">
        <span class="ring ring--3"><span class="ring__label">Онлайн</span></span>
        <span class="ring ring--2"><span class="ring__label">Область</span></span>
        <span class="ring ring--1"><span class="ring__label">Ужгород</span></span>
        <span class="ring__core"></span>
      </div>
      <ol class="reach">
        <li class="reach__item">
          <span class="reach__mark reach__mark--1" aria-hidden="true"></span>
          <h3>Клініка в Ужгороді</h3>
          <p>{ADDRESS}. Прийоми лікарів, УЗД і аналізи.</p>
        </li>
        <li class="reach__item">
          <span class="reach__mark reach__mark--2" aria-hidden="true"></span>
          <h3>Виїзні прийоми в області</h3>
          <p>Фахівці клініки приїжджають у райони Закарпаття, зокрема до Тячева. Найближчі дати уточнюйте за телефоном.</p>
        </li>
        <li class="reach__item">
          <span class="reach__mark reach__mark--3" aria-hidden="true"></span>
          <h3>Онлайн</h3>
          <p>Онлайн-консультація лікаря й онлайн-супровід при цукровому діабеті. Школа діабету: індивідуально або в групі.</p>
        </li>
      </ol>
      <div class="remote__call">
        <CallRow text="Запитайте про онлайн-прийом або виїзд у ваш район." />
      </div>
    </div>
  </Section>

  <!-- 7. contacts: the reception desk, the number set as display. -->
  <Section id="contacts" rec="W-SEO-R003,S-R011,W-A-R006" class="contacts">
    <div class="shell shell--axis">
      <header class="sec-head">
        <span class="axis-node" data-axis-node="contacts"></span>
        <h2>Запис за телефоном</h2>
      </header>
      <a class="big-phone tnum" href={PHONE_MAIN.href}>
        <PhoneIcon size={40} />
        <span>{PHONE_MAIN.display}</span>
      </a>
      <p class="contacts__second">Другий номер: <a class="tnum" href={PHONE_SECOND.href}>{PHONE_SECOND.display}</a></p>

      <div class="contacts__grid">
        <div class="contacts__col">
          <h3>Графік</h3>
          <dl class="week">
            {WEEK.map((d) => (
              <div class="week__row" data-day={d.day}>
                <dt>{d.name}</dt>
                <dd class="tnum">{d.open ? `${d.open}–${d.close}` : "вихідний"}<span class="week__today"> (сьогодні)</span></dd>
              </div>
            ))}
          </dl>
        </div>
        <div class="contacts__col">
          <h3>Адреса</h3>
          <p>{ADDRESS}</p>
          <a class="text-link" href={MAP_URL} target="_blank" rel="noopener">Відкрити на карті</a>
          <a class="text-link" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </div>
        <div class="contacts__col">
          <h3>Ми в соцмережах</h3>
          <a class="text-link" href={INSTAGRAM} target="_blank" rel="noopener">Instagram</a>
          <a class="text-link" href={FACEBOOK} target="_blank" rel="noopener">Facebook</a>
          <FutureLink note="Онлайн-заявка з’явиться в повній версії сайту" class="contacts__online">Онлайн-запис</FutureLink>
        </div>
      </div>
      <p class="trust">Ліцензія МОЗ № 573 від 29.03.2018. Член асоціації CREA. Співпрацюємо зі страховими компаніями.</p>
    </div>
  </Section>

  <Footer slot="footer" />
</Base>

<script>
  import "../scripts/site.ts";
</script>
